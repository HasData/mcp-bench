{
  "target": "duckduckgo",
  "queryVariants": [
    "rust async runtime comparison",
    "sourdough starter troubleshooting",
    "electric bike range test",
    "postgres index bloat",
    "wireguard vs openvpn",
    "kubernetes pod eviction reasons",
    "espresso grind size guide",
    "ceramic knife sharpening",
    "raspberry pi power consumption",
    "typescript satisfies operator",
    "bird migration patterns europe",
    "solar inverter efficiency"
  ],
  "notRun": {
    "DDDMUC/dsh-free-search": "a DeepSeek Harness search plugin, not a standalone MCP server: the npm package ships no binary and its README documents a settings-page card and a /free-search-engine command",
    "brightdata": "rotation rule for this article excludes Bright Data and Apify"
  },
  "servers": [
    {
      "id": "hasdata",
      "transport": "http",
      "url": "https://mcp.hasdata.com/api/mcp?apis=duckduckgo",
      "headers": {
        "x-api-key": "$HASDATA_API_KEY"
      },
      "tasks": [
        {
          "name": "search",
          "tool": "hasdata_duckduckgo_serp_getSearchResults",
          "args": {
            "q": "$Q"
          }
        }
      ]
    },
    {
      "id": "nickclyde-duckduckgo-mcp-server",
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "duckduckgo-mcp-server"
      ],
      "env": {},
      "tasks": [
        {
          "name": "search",
          "tool": "search",
          "args": {
            "query": "$Q",
            "max_results": 10
          }
        }
      ]
    },
    {
      "id": "oevortex-ddg-search",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@oevortex/ddg_search"
      ],
      "env": {},
      "tasks": [
        {
          "name": "search",
          "tool": "web-search",
          "args": {
            "query": "$Q",
            "mode": "web"
          }
        }
      ]
    },
    {
      "id": "zhsama-duckduckgo",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "duckduckgo-mcp-server"
      ],
      "env": {},
      "tasks": [
        {
          "name": "search",
          "tool": "duckduckgo_web_search",
          "args": {
            "query": "$Q",
            "count": 10
          }
        }
      ]
    },
    {
      "id": "open-websearch",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "open-websearch"
      ],
      "env": {},
      "tasks": [
        {
          "name": "search",
          "tool": "search",
          "args": {
            "query": "$Q",
            "limit": 10,
            "engines": [
              "duckduckgo"
            ]
          }
        }
      ]
    },
    {
      "id": "one-search-mcp",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "one-search-mcp"
      ],
      "env": {},
      "tasks": [
        {
          "name": "search",
          "tool": "one_search",
          "args": {
            "query": "$Q",
            "limit": 10
          }
        }
      ]
    },
    {
      "id": "web-scout-mcp",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@pinkpixel/web-scout-mcp"
      ],
      "env": {},
      "tasks": [
        {
          "name": "search",
          "tool": "DuckDuckGoWebSearch",
          "args": {
            "query": "$Q",
            "maxResults": 10
          }
        }
      ]
    },
    {
      "id": "free-search-mcp",
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "free-search-mcp"
      ],
      "env": {},
      "tasks": [
        {
          "name": "search",
          "tool": "search",
          "args": {
            "query": "$Q",
            "engines": [
              "duckduckgo"
            ],
            "max_results": 10,
            "use_cache": false
          }
        }
      ]
    }
  ]
}