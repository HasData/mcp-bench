{
  "target": "google-serp",
  "queryVariants": [
    "best pizza in chicago",
    "python web scraping",
    "nike air max"
  ],
  "servers": [
    {
      "id": "hasdata",
      "transport": "http",
      "url": "https://mcp.hasdata.com/api/mcp?apis=google-serp",
      "headers": {
        "x-api-key": "$HASDATA_API_KEY"
      },
      "tasks": [
        {
          "name": "search",
          "tool": "hasdata_google_serp_serp_getSearchResults",
          "args": {
            "q": "$Q",
            "gl": "us",
            "hl": "en"
          }
        },
        {
          "name": "search-light",
          "tool": "hasdata_google_serp_serp_light_getSearchResults",
          "args": {
            "q": "$Q",
            "gl": "us",
            "hl": "en"
          }
        }
      ]
    },
    {
      "id": "serper",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "serper-search-scrape-mcp-server"
      ],
      "env": {
        "SERPER_API_KEY": "$SERPER_API_KEY"
      },
      "tasks": [
        {
          "name": "search",
          "tool": "google_search",
          "args": {
            "q": "$Q",
            "gl": "us",
            "hl": "en",
            "num": 10
          }
        }
      ]
    },
    {
      "id": "g-search-mcp",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "g-search-mcp"
      ],
      "env": {},
      "tasks": [
        {
          "name": "search",
          "tool": "search",
          "args": {
            "queries": [
              "$Q"
            ],
            "limit": 10
          }
        }
      ]
    },
    {
      "id": "google-search-mcp",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "google-search-mcp"
      ],
      "env": {},
      "tasks": []
    },
    {
      "id": "google-surf-mcp",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "google-surf-mcp"
      ],
      "env": {},
      "tasks": [
        {
          "name": "search",
          "tool": "search",
          "args": {
            "query": "$Q",
            "limit": 10
          }
        }
      ]
    },
    {
      "id": "serpapi",
      "transport": "http",
      "url": "https://mcp.serpapi.com/$SERPAPI_KEY/mcp",
      "headers": {},
      "tasks": [
        {
          "name": "search",
          "tool": "search",
          "args": {
            "params": {
              "engine": "google",
              "q": "$Q",
              "gl": "us",
              "hl": "en"
            },
            "mode": "compact"
          }
        },
        {
          "name": "search-light",
          "tool": "search",
          "args": {
            "params": {
              "engine": "google_light",
              "q": "$Q",
              "gl": "us",
              "hl": "en"
            },
            "mode": "compact"
          }
        }
      ]
    },
    {
      "id": "serphouse",
      "transport": "http",
      "url": "https://mcp.serphouse.com/mcp",
      "headers": {
        "SERPHOUSE_API": "$SERPHOUSE_API_KEY"
      },
      "tasks": [
        {
          "name": "search",
          "tool": "serphouse_google_web",
          "args": {
            "q": "$Q",
            "domain": "google.com",
            "lang": "en",
            "device": "desktop",
            "loc": "United States"
          }
        },
        {
          "name": "search-light",
          "tool": "serphouse_google_web_lite",
          "args": {
            "q": "$Q",
            "domain": "google.com",
            "lang": "en",
            "gl": "US"
          }
        }
      ]
    },
    {
      "id": "noapi-google-search",
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "noapi-google-search-mcp"
      ],
      "env": {},
      "tasks": []
    },
    {
      "id": "nimrod",
      "transport": "http",
      "url": "https://nimrod.orchis.ai/mcp",
      "headers": {},
      "tasks": []
    },
    {
      "id": "openserp",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@openserp/mcp"
      ],
      "env": {},
      "tasks": [
        {
          "name": "search",
          "tool": "search",
          "args": {
            "engine": "google",
            "text": "$Q",
            "lang": "EN",
            "region": "US",
            "limit": 10
          }
        },
        {
          "name": "search-light",
          "tool": "fast_search",
          "args": {
            "text": "$Q",
            "lang": "EN",
            "region": "US",
            "limit": 10
          }
        }
      ]
    }
  ]
}